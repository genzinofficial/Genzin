rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isAdmin() { 
      return isSignedIn() && isEmailVerified() && 
      request.auth.token.email == 'genzin.official@gmail.com'; 
    }

    // 1. Users Collection
    match /users/{userId} {
      function isValidUser(data) {
        return data.userId == request.auth.uid &&
               data.email is string && data.email.size() <= 200 &&
               data.displayName is string && data.displayName.size() <= 100 &&
               data.createdAt == request.time &&
               data.keys().hasAll(['userId', 'email', 'displayName', 'photoURL', 'createdAt']) &&
               data.keys().size() == 5;
      }

      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
        incoming().displayName is string && incoming().displayName.size() <= 100
      );
    }

    // 2. Orders Collection
    match /orders/{orderId} {
      function isValidOrder(data) {
        return data.orderId == orderId &&
               data.userId == request.auth.uid &&
               data.items is list && data.items.size() > 0 &&
               data.total is number && data.total >= 0 &&
               data.status in ['pending', 'completed', 'cancelled'] &&
               data.createdAt == request.time &&
               data.keys().hasAll(['orderId', 'userId', 'items', 'total', 'status', 'createdAt']) &&
               data.keys().size() == 6;
      }

      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isEmailVerified() && isValidOrder(incoming());
      allow update: if isAdmin() || (
        isOwner(existing().userId) && 
        existing().status == 'pending' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status == 'cancelled'
      );
    }
  }
}
